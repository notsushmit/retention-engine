# Copy to .env and fill in. .env is git-ignored.

# Kaggle credentials: uncomment ONE option, or use ~/.kaggle/access_token or
# ~/.kaggle/kaggle.json (chmod 600) and leave these commented. Empty values
# here would override the files.
# KAGGLE_API_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Share of customers kept by `make data` (multiple of 0.01, up to 1.0).
SAMPLE_FRACTION=0.2

# MLflow tracking store and model registry (SQLite; used from Phase 3).
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Valkey store for the scoring service and the replay (used from Phase 8). On the
# host (load-snapshot, the replay, the tests) Valkey is 127.0.0.1:6379; inside the
# compose stack the API reaches it as redis://valkey:6379/0 (set in docker-compose.yml).
VALKEY_URL=redis://localhost:6379/0

# The scoring API started by `make up` (host loopback only).
API_URL=http://127.0.0.1:8000
