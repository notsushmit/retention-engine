# Copy to .env and fill in. .env is git-ignored.

# Kaggle credentials: uncomment ONE option, or use ~/.kaggle/access_token or
# ~/.kaggle/kaggle.json (chmod 600) and leave these commented. Empty values
# here would override the files.
# KAGGLE_API_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Share of customers kept by `make data` (multiple of 0.01, up to 1.0).
SAMPLE_FRACTION=0.2

# MLflow tracking store (used from Phase 3).
MLFLOW_TRACKING_URI=./mlruns
